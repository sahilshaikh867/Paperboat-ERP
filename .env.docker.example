# ==============================================================================
# ⛵ Paperboat Education ERP Platform - Docker Environment Configuration
# Copy this file to .env before starting docker-compose: `cp .env.docker.example .env`
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exam_forge
POSTGRES_PORT=5432

# Redis Cache & Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Security & JWT
JWT_SECRET=paperboat_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Super Admin Account
SUPER_ADMIN_DEFAULT_EMAIL=examforge.superadmin@gmail.com

# Resend API Key for 2FA OTP & Transactional Notifications
RESEND_API_KEY=your_resend_api_key_here
RESEND_ADMIN_API_KEY=your_admin_resend_api_key_here

# Frontend Public API URL (Accessible from client browser)
NEXT_PUBLIC_API_URL=http://localhost:5001
