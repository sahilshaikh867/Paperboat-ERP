# ==============================================================================
# ExamForge College ERP & Assessment Platform - Environment Configuration Example
# Copy this file to .env and populate with your environment secrets.
# NEVER commit .env into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & STORAGE (PostgreSQL 16 & Redis 7)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_forge?schema=public"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECRETS & TOKENS
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-secure-random-64-char-hex-secret-for-jwt"
SESSION_SECRET="generate-a-secure-random-64-char-hex-secret-for-session"

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL CONFIGURATION (Centralized EmailService)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="noreply@examforge.edu"
SMTP_FROM_NAME="ExamForge Academic ERP"

# Optional fallback provider
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (AWS S3 for Student/Teacher Docs, PDFs & Reports)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="exam-forge-academic-assets"

# ------------------------------------------------------------------------------
# 5. NETWORKING & SYSTEM URLS
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV="production"
APP_URL="https://examforge.edu"
FRONTEND_URL="https://app.examforge.edu"
BACKEND_URL="https://api.examforge.edu"
NEXT_PUBLIC_API_URL="https://api.examforge.edu/api/v1"
